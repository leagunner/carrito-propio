---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  socialImage?: string;
  socialImageAlt?: string;
  robots?: string;
  schema?: Record<string, unknown>;
}

const {
  title,
  description = 'Caniles, corrales, jaulas, racks y cajas metálicas para mascotas, hogar y comercio. Consultá precios y comprá directo a Metalúrgica Exhibe en Argentina.',
  canonical = Astro.site?.toString() ?? 'https://catalogo-metalurgica-exhibe.web.app/',
  socialImage = new URL('images/portada1.jpg', canonical).toString(),
  socialImageAlt = 'Metalúrgica Exhibe',
  robots = 'index, follow',
  schema,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <link rel="icon" type="image/png" href="/images/logo-metalurgica-exhibe.png" />
  </head>
  <body>
    <slot />
  </body>
</html>