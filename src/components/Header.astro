---
interface CustomList {
  clave: string;
  titulo: string;
}

interface Props {
  listasPersonalizadas?: CustomList[];
  ordenColecciones?: string[];
}

const { listasPersonalizadas = [], ordenColecciones = [] } = Astro.props;
const titulos: Record<string, string> = {
  jaulas: 'Caniles', cajasTransporte: 'Cajas de transporte', cajasPeluqueria: 'Cajas de transporte y mesa de peluquería',
  corrales: 'Corrales', cercos: 'Cercos lineales y módulos', aves: 'Jaulas para aves', racks: 'Racks apilables',
  parideras: 'Parideras y piletas', varios1: 'Productos varios 1', varios2: 'Productos varios 2', canastos: 'Canastos extraíbles', mallas: 'Mallas metálicas',
};
const sectionId = (clave: string) => clave.startsWith('lista:')
  ? clave.slice('lista:'.length)
  : clave === 'cajasTransporte' ? 'cajas' : clave === 'cajasPeluqueria' ? 'cajas-peluqueria' : clave;
const titulo = (clave: string) => clave.startsWith('lista:')
  ? listasPersonalizadas.find((lista) => `lista:${lista.clave}` === clave)?.titulo ?? clave
  : titulos[clave] ?? clave;
---

<header class="header">
  <div class="header-container">
    <div class="brand">
      <h1>Metalúrgica Exhibe</h1>
      <h2>Catálogo de productos</h2>
    </div>
    <div class="socials">
      <a href="https://www.facebook.com/metalurgicaexhibe" target="_blank" rel="noopener" aria-label="Facebook" title="Facebook">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M13.5 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.6-1.5h1.7V4a22 22 0 0 0-2.4-.1c-2.4 0-4 1.5-4 4.1V10H8v3h2.4v8h3.1Z" fill="currentColor" /></svg>
      </a>
      <a href="https://wa.me/541123419299" target="_blank" rel="noopener" aria-label="WhatsApp" title="WhatsApp">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3.5a8.4 8.4 0 0 0-7.2 12.7L3.4 20.5l4.5-1.4A8.5 8.5 0 1 0 12 3.5Zm0 15.5a7 7 0 0 1-3.6-1l-.3-.2-2.7.8.9-2.6-.2-.3A7 7 0 1 1 12 19Zm3.8-5.1c-.2-.1-1.3-.7-1.5-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.1-.3.2-.5.1a5.7 5.7 0 0 1-1.7-1.1 6.4 6.4 0 0 1-1.2-1.5c-.1-.2 0-.3.1-.4l.4-.5c.1-.1.1-.3.1-.4l-.7-1.7c-.1-.2-.3-.2-.4-.2h-.4c-.2 0-.4.1-.6.3a2.3 2.3 0 0 0-.7 1.7c0 1 .7 2.1.8 2.2.1.1 1.4 2.2 3.5 3.1 1.7.7 2 .6 2.4.6.4 0 1.3-.5 1.5-1 .2-.5.2-.9.1-1 .1-.1 0-.2-.2-.3Z" fill="currentColor" /></svg>
      </a>
      <a href="https://www.instagram.com/metalurgica_exhibe" target="_blank" rel="noopener" aria-label="Instagram" title="Instagram">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" fill="none" stroke="currentColor" stroke-width="1.8" /><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8" /><circle cx="17.4" cy="6.7" r="1.1" fill="currentColor" /></svg>
      </a>
    </div>
  </div>

  <nav class="nav" aria-label="Categorías del catálogo">
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="category-menu">
      <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
      <span>Ver categorías</span>
    </button>

    <div class="menu-overlay" data-menu-close hidden></div>
    <div class="category-menu" id="category-menu" aria-hidden="true">
      <div class="category-menu-header">
        <h3>Categorías</h3>
        <button class="menu-close" type="button" aria-label="Cerrar categorías" data-menu-close>×</button>
      </div>
      <ul>
        {ordenColecciones.map((clave) => <li><a href={`#${sectionId(clave)}`}>{titulo(clave)}</a></li>)}
      </ul>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const menu = document.querySelector('.category-menu');
  const overlay = document.querySelector('.menu-overlay');
  const closeButtons = document.querySelectorAll('[data-menu-close]');
  const categoryLinks = document.querySelectorAll('.category-menu a');
  let menuHistoryActive = false;

  const setMenuState = (isOpen) => {
    toggle?.setAttribute('aria-expanded', String(isOpen));
    menu?.setAttribute('aria-hidden', String(!isOpen));
    menu?.classList.toggle('is-open', isOpen);
    overlay?.toggleAttribute('hidden', !isOpen);
    document.body.classList.toggle('menu-open', isOpen);
  };

  const openMenu = () => {
    setMenuState(true);
    menuHistoryActive = true;
    history.pushState({ ...history.state, categoryMenu: true }, '', window.location.href);
  };

  const closeMenu = ({ goBack = false } = {}) => {
    if (goBack && menuHistoryActive) {
      history.back();
      return;
    }
    setMenuState(false);
    menuHistoryActive = false;
  };

  toggle?.addEventListener('click', () => {
    if (toggle.getAttribute('aria-expanded') === 'true') closeMenu({ goBack: true });
    else openMenu();
  });
  closeButtons.forEach((button) => button.addEventListener('click', () => closeMenu({ goBack: true })));
  categoryLinks.forEach((link) => link.addEventListener('click', (event) => {
    event.preventDefault();
    const sectionId = link.getAttribute('href')?.slice(1);
    history.replaceState({ ...history.state, categoryMenu: false }, '', window.location.href);
    menuHistoryActive = false;
    if (sectionId) {
      document.dispatchEvent(new CustomEvent('catalog:open-section', { detail: { sectionId } }));
      document.getElementById(sectionId)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    setMenuState(false);
  }));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu({ goBack: true });
  });

  window.addEventListener('popstate', (event) => {
    if (!menuHistoryActive || event.state?.categoryMenu) return;
    menuHistoryActive = false;
    setMenuState(false);
    event.stopImmediatePropagation();
  }, true);

  const sections = document.querySelectorAll('.product-section');
  const linksById = new Map(
    [...categoryLinks].map((link) => [link.getAttribute('href')?.slice(1), link]),
  );
  const observer = new IntersectionObserver(
    (entries) => entries.forEach((entry) => {
      if (entry.isIntersecting) {
        linksById.forEach((link) => link.classList.remove('is-active'));
        linksById.get(entry.target.id)?.classList.add('is-active');
      }
    }),
    { rootMargin: '-25% 0px -65% 0px' },
  );
  sections.forEach((section) => observer.observe(section));
</script>